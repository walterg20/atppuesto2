# ATPPuestos2 — Plantilla de variables de entorno
# Copiar a `.env` y completar los valores reales. NUNCA versionar `.env`.

# === Base de datos de la aplicación (SQL Server: `Rentas`) ===
DB_HOST=devmssqlatp.ecom.com.ar
DB_PORT=1433
DB_NAME=Rentas
DB_USER=
DB_PASSWORD=
DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver
# Cadena completa (alternativa a las variables anteriores). Preferir en el backend:
# spring.datasource.url=jdbc:sqlserver://${DB_HOST}:${DB_PORT};databaseName=${DB_NAME};encrypt=true;trustServerCertificate=false
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# === Perfil de Spring ===
SPRING_PROFILES_ACTIVE=dev

# === Seguridad / tokens (rellenar al definir el módulo de seguridad) ===
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# === Frontend (Angular) ===
# URL base de la API REST consumida por el frontend
API_BASE_URL=http://localhost:8080/api/v1
