# === Secretos y entorno ===
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# === Backend (Java / Maven) ===
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/**/*.class
*.log

# === Frontend (Node / Angular) ===
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
npm-debug.log*
yarn-error.log*

# === IDE / Editor ===
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.suo
*.user

# === OS ===
Thumbs.db
Desktop.ini
.DS_Store

# === GeneXus (nunca versionar artefactos de la KB en este repo) ===
# Patrones de carpeta anclados a la raiz (con "/") para NO ignorar
# paquetes Java legitimamente llamados "web" dentro de backend/.
*.gxw
*.xpz
*.gxSource
*.gxForm
/Data*/
/web/

# === Temporales ===
*.tmp
*.bak
~$*
